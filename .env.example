# Copy to .env and adjust. Never commit the real .env.

# --- docker compose ---
POSTGRES_DB=agentledger
POSTGRES_USER=agentledger
POSTGRES_PASSWORD=change-me
APP_PORT=8080

# --- application (also usable without compose) ---
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/agentledger
DATABASE_USERNAME=agentledger
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10
# Sample proposals on an empty database; set false in production.
AGENTLEDGER_SEED_DEMO_DATA=true
AGENTLEDGER_MAX_BODY_BYTES=16384
AGENTLEDGER_RATE_LIMIT_ENABLED=true
AGENTLEDGER_RATE_LIMIT_CAPACITY=30
AGENTLEDGER_RATE_LIMIT_REFILL_PER_MINUTE=30
# "ecs" (JSON) or "logstash"; empty for plain text.
LOG_FORMAT=ecs
# "framework" only behind a trusted reverse proxy that sets X-Forwarded-*.
SERVER_FORWARD_HEADERS_STRATEGY=none
